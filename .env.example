# Copy this file to .env and fill in your values.
# NEVER put real keys in this file — it is committed to git.

# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx_or_legacy_anon_key

# Note: the app only ever needs the publishable/anon key.
# The secret key must never go into NEXT_PUBLIC_* variables.
